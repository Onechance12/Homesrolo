{
  "name": "homesrolo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/tests/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run test:directory && npm run web:build && npm run guard:web",
    "test:directory": "node --experimental-strip-types --test 'apps/web/lib/directory/tests/*.test.ts'",
    "web:lint": "npm --prefix apps/web run lint",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:build": "npm --prefix apps/web run build",
    "guard:web": "node scripts/public-web-guard.mjs"
  },
  "dependencies": {
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  }
}
