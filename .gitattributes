* text=auto

# Contract and application sources must have identical bytes on Windows,
# macOS, and Linux. Several wire-contract tests intentionally hash source and
# canonical fixtures, so platform-native CRLF conversion is not acceptable.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
